{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talyvor",
  "version": "0.1.0",
  "identifier": "com.talyvor.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "taly",
        "title": "Taly",
        "url": "index.html",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self' blob: mediastream:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Finance",
    "shortDescription": "Taly, Talyvor's assistant, in the menu bar",
    "copyright": "Talyvor Ltd",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
